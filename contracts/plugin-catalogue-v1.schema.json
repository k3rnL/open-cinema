{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-cinema.local/schemas/plugin-catalogue-v1.schema.json",
  "title": "Open Cinema first-party plugin catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "plugins"],
  "properties": {
    "schemaVersion": {"const": 1},
    "plugins": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/plugin"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "summary",
        "publisher",
        "verifiedPublisher",
        "repository",
        "documentationUrl",
        "icon",
        "versions"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "displayName": {"type": "string", "minLength": 1, "maxLength": 120},
        "summary": {"type": "string", "minLength": 1, "maxLength": 1024},
        "publisher": {"type": "string", "minLength": 1, "maxLength": 120},
        "verifiedPublisher": {"type": "boolean"},
        "repository": {"type": "string", "format": "uri", "maxLength": 2048},
        "documentationUrl": {"type": "string", "format": "uri", "maxLength": 2048},
        "icon": {"type": "string", "minLength": 1, "maxLength": 64},
        "versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/version"}
        }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "revision",
        "mutable",
        "published",
        "pluginContract",
        "openCinema",
        "capabilities"
      ],
      "properties": {
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "revision": {"type": "string", "minLength": 1, "maxLength": 256},
        "resolvedCommit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "artifactDigest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "mutable": {"type": "boolean"},
        "published": {"type": "boolean"},
        "pluginContract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": {"type": "integer", "minimum": 1},
            "maximum": {"type": "integer", "minimum": 1}
          }
        },
        "openCinema": {"type": "string", "minLength": 1, "maxLength": 120},
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"enum": ["api", "automation", "processing", "managed-resource", "managed-audio-source", "admin-ui"]}
        }
      }
    }
  }
}
