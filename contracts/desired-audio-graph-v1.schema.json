{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-cinema.local/contracts/desired-audio-graph-v1.schema.json",
  "title": "Open Cinema desired audio graph v1",
  "description": "Persistent audio intent. Runtime PipeWire identifiers are deliberately absent.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "metadata",
    "parameters",
    "publicPorts",
    "conditions",
    "nodes",
    "edges",
    "layout"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"$ref": "#/$defs/stableId"},
    "kind": {"enum": ["graph", "subgraph"]},
    "metadata": {"$ref": "#/$defs/metadata"},
    "parameters": {
      "type": "array",
      "items": {"$ref": "#/$defs/parameterDefinition"}
    },
    "publicPorts": {
      "type": "array",
      "items": {"$ref": "#/$defs/publicPort"}
    },
    "conditions": {
      "type": "array",
      "items": {"$ref": "#/$defs/namedCondition"}
    },
    "nodes": {
      "type": "array",
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/$defs/edge"}
    },
    "layout": {"$ref": "#/$defs/layout"},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
    },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 255},
        "description": {"type": "string", "maxLength": 4096},
        "labels": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/name"},
          "additionalProperties": {"type": "string", "maxLength": 255}
        },
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "parameterDefinition": {
      "type": "object",
      "required": ["name", "type", "required"],
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "type": {
          "enum": ["string", "integer", "number", "boolean", "enum", "object", "array"]
        },
        "description": {"type": "string", "maxLength": 2048},
        "required": {"type": "boolean"},
        "default": true,
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": ["string", "number", "integer", "boolean"]}
        },
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "minLength": {"type": "integer", "minimum": 0},
        "maxLength": {"type": "integer", "minimum": 0},
        "items": {"type": "object"},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "publicPort": {
      "type": "object",
      "required": ["name", "direction", "contract"],
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "description": {"type": "string", "maxLength": 2048},
        "direction": {"enum": ["input", "output"]},
        "contract": {"$ref": "#/$defs/signalContract"},
        "internalBinding": {"$ref": "#/$defs/portReference"},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "signalContract": {
      "type": "object",
      "required": ["mediaKind"],
      "additionalProperties": false,
      "properties": {
        "mediaKind": {"enum": ["audio", "control"]},
        "content": {"enum": ["any", "pcm", "encoded"]},
        "codecs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "sampleFormats": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "rates": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "layouts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/channelLayout"}
        },
        "latencyMs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minimum": {"type": "number", "minimum": 0},
            "maximum": {"type": "number", "minimum": 0}
          }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/name"}
        },
        "requiredCapabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/name"}
        },
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "channelLayout": {
      "type": "object",
      "required": ["channels"],
      "additionalProperties": false,
      "properties": {
        "channels": {"type": "integer", "minimum": 1, "maximum": 64},
        "positions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "namedCondition": {
      "type": "object",
      "required": ["id", "expression"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "expression": {"$ref": "#/$defs/conditionExpression"},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "conditionExpression": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": {"type": "string", "minLength": 1},
        "args": {"type": "array", "items": {"$ref": "#/$defs/conditionExpression"}},
        "arg": {"$ref": "#/$defs/conditionExpression"},
        "fact": {"type": "string", "minLength": 1},
        "value": true,
        "values": {"type": "array"},
        "durationMs": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "conditionUse": {
      "type": "object",
      "required": ["unknownResult"],
      "additionalProperties": false,
      "oneOf": [
        {"required": ["expression"]},
        {"required": ["reference"]}
      ],
      "properties": {
        "expression": {"$ref": "#/$defs/conditionExpression"},
        "reference": {"$ref": "#/$defs/stableId"},
        "unknownResult": {"enum": ["eligible", "ineligible", "waiting", "error"]}
      }
    },
    "parameterBinding": {
      "oneOf": [
        {
          "type": "object",
          "required": ["parameter"],
          "additionalProperties": false,
          "properties": {"parameter": {"$ref": "#/$defs/name"}}
        },
        {
          "type": "object",
          "required": ["value"],
          "additionalProperties": false,
          "properties": {"value": true}
        }
      ]
    },
    "parameterBindings": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {"$ref": "#/$defs/parameterBinding"}
    },
    "subgraphInstance": {
      "type": "object",
      "required": ["definitionId", "revisionId", "parameterBindings", "portBindings"],
      "additionalProperties": false,
      "properties": {
        "definitionId": {"$ref": "#/$defs/stableId"},
        "revisionId": {"$ref": "#/$defs/stableId"},
        "parameterBindings": {"$ref": "#/$defs/parameterBindings"},
        "portBindings": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/name"},
          "additionalProperties": {"$ref": "#/$defs/name"}
        }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "type", "version", "configuration"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "type": {"type": "string", "minLength": 1, "maxLength": 255},
        "version": {"type": "integer", "minimum": 1},
        "configuration": {"type": "object"},
        "parameterBindings": {"$ref": "#/$defs/parameterBindings"},
        "condition": {"$ref": "#/$defs/conditionUse"},
        "subgraph": {"$ref": "#/$defs/subgraphInstance"},
        "layout": {"$ref": "#/$defs/nodeLayout"},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "portReference": {
      "type": "object",
      "required": ["node", "port"],
      "additionalProperties": false,
      "properties": {
        "node": {"$ref": "#/$defs/stableId"},
        "port": {"$ref": "#/$defs/name"}
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "from", "to"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "from": {"$ref": "#/$defs/portReference"},
        "to": {"$ref": "#/$defs/portReference"},
        "condition": {"$ref": "#/$defs/conditionUse"},
        "policy": {"type": "object"},
        "layout": {"$ref": "#/$defs/edgeLayout"},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "nodeLayout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "width": {"type": "number", "minimum": 0},
        "height": {"type": "number", "minimum": 0},
        "collapsed": {"type": "boolean"},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "edgeLayout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {"type": "string", "maxLength": 255},
        "controlPoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["x", "y"],
            "additionalProperties": false,
            "properties": {"x": {"type": "number"}, "y": {"type": "number"}}
          }
        },
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "viewport": {
          "type": "object",
          "required": ["x", "y", "zoom"],
          "additionalProperties": false,
          "properties": {
            "x": {"type": "number"},
            "y": {"type": "number"},
            "zoom": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
      "additionalProperties": true
    }
  }
}
