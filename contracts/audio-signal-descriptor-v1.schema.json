{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-cinema.local/contracts/audio-signal-descriptor-v1.schema.json",
  "title": "Open Cinema audio signal descriptor v1",
  "type": "object",
  "required": [
    "version",
    "transport",
    "content",
    "decodedOutput",
    "confidence",
    "source",
    "observedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "transport": {"$ref": "#/$defs/transport"},
    "content": {"$ref": "#/$defs/content"},
    "decodedOutput": {
      "oneOf": [
        {"$ref": "#/$defs/audioFormat"},
        {"type": "null"}
      ]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "source": {"$ref": "#/$defs/source"},
    "observedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "layout": {
      "type": "object",
      "required": ["channels"],
      "additionalProperties": false,
      "properties": {
        "channels": {"type": "integer", "minimum": 1, "maximum": 64},
        "positions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "audioFormat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sampleFormat": {"type": "string", "minLength": 1},
        "rate": {"type": "integer", "minimum": 1},
        "layout": {"$ref": "#/$defs/layout"}
      }
    },
    "transport": {
      "type": "object",
      "required": ["kind", "format"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["unknown", "pcm", "iec61937"]},
        "format": {"$ref": "#/$defs/audioFormat"}
      }
    },
    "content": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["unknown", "pcm", "encoded", "silence"]},
        "codec": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._+-]{0,63}$"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "encoded"}}},
          "then": {"required": ["codec"]},
          "else": {"not": {"required": ["codec"]}}
        }
      ]
    },
    "source": {
      "type": "object",
      "required": ["kind", "id"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["wireplumber", "decoder", "processor", "replay"]},
        "id": {"type": "string", "minLength": 1},
        "sequence": {"type": "integer", "minimum": 0}
      }
    }
  }
}
