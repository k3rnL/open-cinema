[Unit]
Description=Open Cinema Django Application
Documentation=https://github.com/{{ open_cinema_release_manifest.components.open_cinema.repository }}
After=network.target redis-server.service user@{{ open_cinema_service_uid }}.service
Wants=redis-server.service user@{{ open_cinema_service_uid }}.service
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=exec
User={{ open_cinema.user }}
Group={{ open_cinema.group }}
WorkingDirectory={{ open_cinema.app_path }}
EnvironmentFile={{ open_cinema.app_path }}/.env
Environment="XDG_RUNTIME_DIR={{ audio_service.runtime_dir }}"
Environment="DBUS_SESSION_BUS_ADDRESS={{ audio_service.dbus_address }}"
Environment="PIPEWIRE_REMOTE=pipewire-0"
RuntimeDirectory=open-cinema
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
UMask=0027

ExecStart={{ open_cinema.venv_path }}/bin/gunicorn \
    --workers {{ open_cinema.gunicorn_workers }} \
    --bind 0.0.0.0:{{ open_cinema.gunicorn_port }} \
    --timeout 120 \
    --access-logfile /var/log/open-cinema/access.log \
    --error-logfile /var/log/open-cinema/error.log \
    --log-level debug \
    --capture-output \
    opencinema.wsgi:application

Restart=on-failure
RestartSec=5
TimeoutStartSec=30s
TimeoutStopSec=30s
KillSignal=SIGTERM
KillMode=mixed

# Security hardening
# The reviewed root-helper path requires one exact sudo transition. Keep the
# stronger setting whenever appliance controls are not installed.
NoNewPrivileges={{ (not (open_cinema.system_control.enabled | bool)) | lower }}
PrivateTmp=true
ProtectSystem=strict
# ProtectHome also hides /run/user, which contains the owned PipeWire socket.
ProtectHome=false
InaccessiblePaths=/home /root
ReadWritePaths={{ open_cinema.app_path }} {{ open_cinema.plugins.root }} {{ open_cinema.plugins.secret_dir }} /run/open-cinema /var/log/open-cinema /var/lib/open-cinema

[Install]
WantedBy=multi-user.target
