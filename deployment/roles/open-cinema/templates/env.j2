# Django environment configuration
# Managed by Ansible

DJANGO_SECRET_KEY={{ open_cinema.django.secret_key }}
DJANGO_DEBUG={{ open_cinema.django.debug | lower }}
DJANGO_ALLOWED_HOSTS={{ open_cinema.django.allowed_hosts }},{{ ansible_facts['default_ipv4']['address'] }},{{ ansible_facts['hostname'] }}
DATABASE_PATH={{ open_cinema.django.database }}
OPEN_CINEMA_SQLITE_BUSY_TIMEOUT_MS={{ open_cinema.sqlite.busy_timeout_ms }}
OPEN_CINEMA_SQLITE_WAL_AUTOCHECKPOINT_PAGES={{ open_cinema.sqlite.wal_autocheckpoint_pages }}
OPEN_CINEMA_ORCHESTRATOR_LOCK_PATH={{ open_cinema.orchestrator_lock_path }}
OPEN_CINEMA_RUNTIME_REDIS_URL=redis://127.0.0.1:6379/0
OPEN_CINEMA_RUNTIME_REDIS_KEY={{ open_cinema.runtime_redis_key }}
OPEN_CINEMA_AUDIO_ADAPTER_MEDIA_ROOT={{ open_cinema.audio_adapter_media_root }}
OPEN_CINEMA_PLUGIN_ROOT={{ open_cinema.plugins.root }}
OPEN_CINEMA_PLUGIN_SECRET_DIR={{ open_cinema.plugins.secret_dir }}
OPEN_CINEMA_PLUGIN_RUNTIME_DIR={{ open_cinema.plugins.root }}/runtime
OPEN_CINEMA_PLUGIN_GENERATION_RETENTION={{ open_cinema.plugins.generation_retention }}
OPEN_CINEMA_PLUGIN_GENERATION_MAX_BYTES={{ open_cinema.plugins.generation_max_bytes }}
OPEN_CINEMA_PLUGIN_ALLOW_EDITABLE={{ open_cinema.plugins.allow_editable | bool | int }}
OPEN_CINEMA_PLUGIN_EDITABLE_DIRS={{ open_cinema.plugins.editable_dirs | join(':') }}

# Accepted full audio runtime. A changed candidate remains observable while the
# contract gate withholds processor and live mutation privileges.
OPEN_CINEMA_AUDIO_ORCHESTRATION_API={{ open_cinema.orchestration_features.orchestration_api | bool | lower }}
OPEN_CINEMA_AUDIO_RUNTIME_OBSERVATION={{ open_cinema.orchestration_features.runtime_observation | bool | lower }}
OPEN_CINEMA_AUDIO_SHADOW_RESOLUTION={{ open_cinema.orchestration_features.shadow_resolution | bool | lower }}
OPEN_CINEMA_AUDIO_PROCESSOR_MANAGEMENT={{ ((open_cinema.orchestration_features.processor_management | bool) and (open_cinema_contract_gate_complete | default(false) | bool)) | lower }}
OPEN_CINEMA_AUDIO_LIVE_RECONCILIATION={{ ((open_cinema.orchestration_features.live_reconciliation | bool) and (open_cinema_contract_gate_complete | default(false) | bool)) | lower }}
OPEN_CINEMA_AUDIO_LIVE_GRAPH_ALLOWLIST=*
OPEN_CINEMA_AUDIO_RECONCILIATION_CATCHUP_MAX_PASSES={{ open_cinema.reconciliation_catchup.max_passes }}
OPEN_CINEMA_AUDIO_RECONCILIATION_RETRY_INITIAL_SECONDS={{ open_cinema.reconciliation_catchup.retry_initial_seconds }}
OPEN_CINEMA_AUDIO_RECONCILIATION_RETRY_MAX_SECONDS={{ open_cinema.reconciliation_catchup.retry_max_seconds }}
OPEN_CINEMA_AUDIO_RECONCILIATION_RETRY_MULTIPLIER={{ open_cinema.reconciliation_catchup.retry_multiplier }}
OPEN_CINEMA_CAMILLADSP_INSTANCE_COUNT={{ camilladsp.instance_count }}
OPEN_CINEMA_DECODER_INSTANCE_COUNT={{ pcm_auto_decoder.instance_count }}
OPEN_CINEMA_AUDIO_PLAN_RETENTION_DAYS={{ open_cinema.retention.plan_days }}
OPEN_CINEMA_AUDIO_AUDIT_RETENTION_DAYS={{ open_cinema.retention.audit_days }}
OPEN_CINEMA_AUDIO_DIAGNOSTIC_RETENTION_HOURS={{ open_cinema.retention.diagnostic_hours }}
OPEN_CINEMA_AUDIO_RUNTIME_PROJECTION_RETENTION_HOURS={{ open_cinema.retention.runtime_projection_hours }}
OPEN_CINEMA_AUDIO_RETENTION_BATCH_SIZE={{ open_cinema.retention.batch_size }}

# CamillaDSP configuration
CAMILLADSP_HOST=localhost
CAMILLADSP_PORT={{ camilladsp.websocket_port }}

# Celery/Redis configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_RESULT_EXPIRES={{ open_cinema.celery.result_expires_seconds }}
CELERY_TASK_IGNORE_RESULT=true
CELERY_WORKER_PREFETCH_MULTIPLIER={{ open_cinema.celery.prefetch_multiplier }}
