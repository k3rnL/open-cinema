[Unit]
Description=Open Cinema managed PCM auto decoder (%i)
Documentation=file://{{ open_cinema.app_path }}/docs/audio-orchestration/DECODER_DRIVER.md
After=user@{{ open_cinema_uid }}.service open-cinema-orchestrator.service
Wants=user@{{ open_cinema_uid }}.service
ConditionPathExists=/run/open-cinema/decoder/%i.env

[Service]
Type=simple
User={{ open_cinema.user }}
Group={{ open_cinema.group }}
SupplementaryGroups=audio
UMask=0027
EnvironmentFile=/run/open-cinema/decoder/%i.env
Environment="XDG_RUNTIME_DIR={{ audio_service.runtime_dir }}"
Environment="DBUS_SESSION_BUS_ADDRESS={{ audio_service.dbus_address }}"
Environment="PIPEWIRE_REMOTE=pipewire-0"
ExecStartPre=/usr/bin/test -S {{ audio_service.pipewire_socket }}
ExecStart={{ pcm_auto_decoder.install_path }} --instance-id %i --status-socket /run/open-cinema/decoder/%i.sock $DECODER_ARGS
Restart=on-failure
RestartSec=2s
TimeoutStartSec=20s
TimeoutStopSec=10s
KillSignal=SIGTERM
KillMode=mixed

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
# ProtectHome also hides /run/user, which contains the owned PipeWire socket.
ProtectHome=false
InaccessiblePaths=/home /root
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
ReadWritePaths=/run/open-cinema/decoder

[Install]
WantedBy=multi-user.target
